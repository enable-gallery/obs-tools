# Twitch app credentials (from https://dev.twitch.tv/console)
TWITCH_CLIENT_ID=your_client_id
TWITCH_CLIENT_SECRET=your_client_secret

# Must exactly match a redirect URI registered on your Twitch app
TWITCH_REDIRECT_URI=http://localhost:3000/callback

# Broadcaster's channel login name (the account the rewards belong to)
TWITCH_CHANNEL=your_channel_name

# OBS WebSocket (Tools > WebSocket Server Settings in OBS 28+)
OBS_WEBSOCKET_URL=ws://127.0.0.1:4455
OBS_WEBSOCKET_PASSWORD=

# Local web dashboard (manual scene switching, pause toggle, live redemption feed)
DASHBOARD_PORT=4510
