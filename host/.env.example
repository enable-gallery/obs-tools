# Everything below is optional at startup — host runs fine with none of it
# set and just waits. Open the setup page (http://localhost:4600 by default,
# see SETUP_PORT below) to enter any of these at runtime instead; whatever
# you save there is written back here for next run.

# Local setup page's port
SETUP_PORT=4600

# Twitch app Client ID (from https://dev.twitch.tv/console — no client
# secret or redirect URI needed, auth uses the Device Code Grant flow: click
# Connect on the setup page and enter the short code it shows you at the
# URL it gives you). Channel name is derived automatically from whichever
# account you authorize as.
TWITCH_CLIENT_ID=your_client_id

# OBS WebSocket (Tools > WebSocket Server Settings in OBS 28+) — only needed
# if camera-switcher is enabled
OBS_WEBSOCKET_URL=ws://127.0.0.1:4455
OBS_WEBSOCKET_PASSWORD=

# Discord bot token (Discord Developer Portal > your app > Bot > Reset/Copy
# Token) — only needed if discord-notify is enabled. The bot also needs to
# be invited to your server with the "Send Messages" permission.
DISCORD_BOT_TOKEN=your_bot_token
